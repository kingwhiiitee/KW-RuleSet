payload:
    # TikTok — verified 2026-11-07
    # TikTok-only names from the TikTok-Unlock list. snssdk.com stays in Douyin.
    # Shared-CDN region token is the last hyphen segment: sg, va, alisg, useast1a, useast2a, useast5, useast8.
    # https://github.com/Semporia/TikTok-Unlock/blob/master/Surge/TikTok.list
    - DOMAIN,p16-tiktokcdn-com.akamaized.net
    - DOMAIN-SUFFIX,byteoversea.com
    - DOMAIN-SUFFIX,muscdn.com
    - DOMAIN-SUFFIX,musical.ly
    - DOMAIN-SUFFIX,sgpstatp.com
    - DOMAIN-SUFFIX,tik-tokapi.com
    - DOMAIN-SUFFIX,tiktok.com
    - DOMAIN-SUFFIX,tiktokcdn.com
    - DOMAIN-SUFFIX,tiktokv.com
    - DOMAIN-KEYWORD,-tiktokcdn-com
    - DOMAIN-KEYWORD,-tiktok-

    # p16-sign-sg.ibyteimg.com and the same tokens on ibytedtos.com / ipstatp.com
    - DOMAIN-WILDCARD,*-alisg.ibyteimg.com
    - DOMAIN-WILDCARD,*-sg.ibyteimg.com
    - DOMAIN-WILDCARD,*-useast1a.ibyteimg.com
    - DOMAIN-WILDCARD,*-useast2a.ibyteimg.com
    - DOMAIN-WILDCARD,*-useast5.ibyteimg.com
    - DOMAIN-WILDCARD,*-useast8.ibyteimg.com
    - DOMAIN-WILDCARD,*-va.ibyteimg.com
    - DOMAIN-WILDCARD,*-alisg.ibytedtos.com
    - DOMAIN-WILDCARD,*-sg.ibytedtos.com
    - DOMAIN-WILDCARD,*-useast1a.ibytedtos.com
    - DOMAIN-WILDCARD,*-useast2a.ibytedtos.com
    - DOMAIN-WILDCARD,*-useast5.ibytedtos.com
    - DOMAIN-WILDCARD,*-useast8.ibytedtos.com
    - DOMAIN-WILDCARD,*-va.ibytedtos.com
    - DOMAIN-WILDCARD,*-alisg.ipstatp.com
    - DOMAIN-WILDCARD,*-sg.ipstatp.com
    - DOMAIN-WILDCARD,*-useast1a.ipstatp.com
    - DOMAIN-WILDCARD,*-useast2a.ipstatp.com
    - DOMAIN-WILDCARD,*-useast5.ipstatp.com
    - DOMAIN-WILDCARD,*-useast8.ipstatp.com
    - DOMAIN-WILDCARD,*-va.ipstatp.com

    - USER-AGENT,TikTok*
