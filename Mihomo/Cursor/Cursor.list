payload:
    # Cursor — verified 2026-11-07
    # Official allowlist. DOMAIN-SUFFIX,cursorvm.com also matches nested *.*.cursorvm.com hosts.
    # https://cursor.com/docs/enterprise/network-configuration
    # https://cursor.com/help/troubleshooting/network
    - DOMAIN-SUFFIX,cursor-cdn.com
    - DOMAIN-SUFFIX,cursor.com
    - DOMAIN-SUFFIX,cursor.sh
    - DOMAIN-SUFFIX,cursorapi.com
    - DOMAIN-SUFFIX,cursorvm.com

    # Anysphere company domains carried from the previous ruleset.
    - DOMAIN-SUFFIX,anysphere.co
    - DOMAIN-SUFFIX,anysphere.dev

    # Sign-in and the update bucket named by Cursor. The surrounding x.ai,
    # spacex.ai, and amazonaws.com zones are not included.
    # https://cursor.com/docs/enterprise/network-configuration
    - DOMAIN,accounts.spacex.ai
    - DOMAIN,accounts.x.ai
    - DOMAIN,anysphere-binaries.s3.us-east-1.amazonaws.com

    # No IP rules. Cursor says backend addresses change, and the old list was
    # shared AWS, GCP, and S3 space.
